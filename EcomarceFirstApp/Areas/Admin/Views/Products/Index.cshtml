@using EcomarceFirstApp.ViewModels
@model List<ProductsViewModel>
<div class="table-responsive">

    <table class="table table-hover text-nowrap">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Price</th>
                <th>Discount</th>
                <th>salePrice</th>
                <th>Category</th>
                <th>Image</th>
                <th>Action</th>

            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Price</td>
                    <td>@item.Discount</td>
                    <td>@item.SalePrice</td>
                    <td>@item.CategoryName</td>
                    <td>
                        <img src="@item.ImageUrl" width="60px" />
                    </td>
                    <td>
                        <a href="/Admin/Products/Edit/@item.Id" class="btn btn-outline-success">update</a>
                        <a href="/Admin/Products/Remove/@item.Id" class="btn btn-outline-danger">delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>



</div>

