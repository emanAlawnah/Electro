@using EcomarceFirstApp.ViewModels
@model List<CategoriesViewModel>
<div class="table-responsive">

    <table class="table table-hover text-nowrap">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Image</th>
            <th>Action</th>
            
        </tr>
    </thead>
    <tbody>
        @foreach(var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>
                    <img src="@item.ImageUrl" alt="@item.Name" style="width: 40px; height: auto;" />

                </td>

                <td>
                    <a href="/Admin/Categories/Details/@item.Id" class="btn btn-outline-primary">details</a>
                    <a href="/Admin/Categories/Edit/@item.Id" class="btn btn-outline-success">update</a>
                    <a href="/Admin/Categories/Remove/@item.Id" class="btn btn-outline-danger">delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
